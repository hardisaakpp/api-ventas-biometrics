# Copiar a .env en la raíz de klienteV1. dat_cws.php carga .env desde el directorio padre de cws/.

# --- SQL Server (cx/dat_scs.php → bd_scs.php: ventas, asistencias, V-Count → staging) ---
SQL_SCS_HOST=
SQL_SCS_DATABASE=
SQL_SCS_USER=
SQL_SCS_PASSWORD=

# --- KOACH360 (manual API: login JWT + ventas + asistencias) ---
# KOACH360_BASE_URL=https://koach360.kliente.tech:5000
# KOACH360_ENVIRONMENT=PRUEBAS
KOACH360_USUARIO=
# KOACH360_PASSWORD_PRUEBAS=
# KOACH360_PASSWORD_PRODUCCION=
# KOACH360_PASSWORD=
# clienteId numérico en el JSON (ventas y asistencias). Si vacío, se usa CLI_PVENTAS o 17.
# KOACH360_CLIENT_ID=17
# Compatibilidad: si KOACH360_* vacío, se pueden usar aún US_PVENTAS / PS_PVENTAS como usuario/contraseña.
# US_PVENTAS=
# PS_PVENTAS=
# CLI_PVENTAS=17

# Hora por defecto al expandir asistencias programadas (syn_put_asistencias_prog).
# KOACH360_HORA_PROG_DEFAULT=09:00

# --- Ventas: correo asesor vía nómina (opcional; requiere BDDNOMINAMABEL19 online) ---
# VENTAS_ASESOR_FROM_NOMINA=1
# VENTAS_ASESOR_CORREO_COLUMN=EmailEmpresa
# VENTAS_ASESOR_CORREO_COLUMN=none

# --- V-Count BoostBI ---
US_VCOUNT=
PS_VCOUNT=
# URL_VCOUNT=https://boostbi.v-count.com/api/v4/vcountapi
# URL_VCOUNT_DAILY=https://boostbi.v-count.com/api/v4/vcountapi_daily

# --- HTTP: timeouts y reintentos (opcional; KOACH360 / V-Count) ---
# KOACH360_HTTP_TIMEOUT=3600
# KOACH360_CONNECT_TIMEOUT=20
# KOACH360_RETRY_MAX=3
# VCOUNT_HTTP_TIMEOUT=3600
# VCOUNT_CONNECT_TIMEOUT=20
# VCOUNT_RETRY_MAX=3

# --- check_env.php: no exigir SQL_SCS_* (solo validar KOACH360) ---
# CWS_CHECK_ENV_NO_SQL=1

# --- Depuración asistencias (opcional) ---
# ASIST_DEBUG=1

# --- store_employees.php: catálogo tiendas (?meta=almacenes) ---
# Base donde está dbo.almacenes (tres partes [BD].[dbo].[almacenes]) si NO usas conexión SAP.
# STORE_ALMACEN_DATABASE=STORECONTROL
# Patrón LIKE para nombre (default ROLAND%).
# STORE_ALMACEN_NOMBRE_LIKE=ROLAND%
#
# Conexión dedicada SAP (si están todas, ?meta=almacenes usa este servidor + BD; FROM dbo.almacenes).
# SQL_SERVER_SAP_DRIVER se documenta para ODBC; sqlsrv en PHP no la lee.
# SQL_SERVER_SAP_SERVER=
# SQL_SERVER_SAP_DATABASE=STORECONTROL
# SQL_SERVER_SAP_UID=
# SQL_SERVER_SAP_PWD=
# Encriptación TLS (Driver 18). 0 para desactivar Encrypt=yes si falla la conexión.
# SQL_SERVER_SAP_ENCRYPT=1

# --- store_employees.php: validación cédula (solo dígitos) ---
# Por defecto exacto de 10 dígitos.
# STORE_EMPLOYEES_CEDULA_MIN_LEN=10
# STORE_EMPLOYEES_CEDULA_MAX_LEN=10
