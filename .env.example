# Copiar a ".env" en la raíz de klienteV1 y rellenar valores.
# No commitear .env
#
# Valores con espacios o # deben ir entre comillas dobles.
# Opcional: composer require vlucas/phpdotenv (entonces se usa esa librería si está instalada).

